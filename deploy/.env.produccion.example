# =============================================================================
# .env.docker de PRODUCCIÓN — copiar como .env.docker y rellenar
# =============================================================================
APP_NAME="Contratación Abierta"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://contratacionabierta.com

# php artisan key:generate --show
APP_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Base de datos: VM de PostgreSQL por red privada -------------------------
DB_CONNECTION=pgsql
DB_HOST=10.0.0.10
DB_PORT=5432
DB_DATABASE=contratacion
DB_USERNAME=contratacion
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- Correo (alertas por email) ---------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Contratación Abierta"

# --- Panel de administración -------------------------------------------------
# Restringe el acceso al panel a tus IP. NO dejes 0.0.0.0/0 en producción.
ADMIN_ALLOWED_IPS=
ADMIN_PASSWORD=
